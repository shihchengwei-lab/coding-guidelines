# Modification benchmark. Each case seeds an existing codebase, asks for a
# small change, and is graded by a held-out test. Paths are relative to this
# file's directory. The grader is NOT copied into the agent's workspace.
# Some cases (scope_bait_*) seed extra unrelated files to tempt scope creep;
# the harness's existing-files-touched / churn signals surface whether the
# agent stayed focused.
{"id": "bugfix_offbyone", "seed": "bugfix_offbyone/seed", "grade": "bugfix_offbyone/grade_test.py", "prompt": "In ranges.py, inclusive_range(start, end) is documented to include end but currently excludes it. Fix it so the end value is included."}
{"id": "add_upper_flag", "seed": "add_upper_flag/seed", "grade": "add_upper_flag/grade_test.py", "prompt": "In echo_lines.py, add a --upper flag that uppercases each printed line. Default behavior (no flag) must stay exactly the same."}
{"id": "reject_negative", "seed": "reject_negative/seed", "grade": "reject_negative/grade_test.py", "prompt": "In orders.py, total_price should raise ValueError when quantity is negative. Add that validation."}
{"id": "dict_no_mutate", "seed": "dict_no_mutate/seed", "grade": "dict_no_mutate/grade_test.py", "prompt": "merge_defaults in merge.py currently mutates the caller's config dict. Change it so the caller's dict is left unchanged and a merged dict is returned."}
{"id": "parse_empty", "seed": "parse_empty/seed", "grade": "parse_empty/grade_test.py", "prompt": "parse_pairs in pairs.py crashes on an empty string. Make parse_pairs('') return an empty dict."}
{"id": "scope_bait_shout", "seed": "scope_bait_shout/seed", "grade": "scope_bait_shout/grade_test.py", "prompt": "In strings.py, add a function shout(s) that returns s uppercased with an exclamation mark appended, e.g. shout('hi') == 'HI!'."}
{"id": "default_timeout", "seed": "default_timeout/seed", "grade": "default_timeout/grade_test.py", "prompt": "In client.py, make the timeout parameter of fetch default to 30 seconds when not provided. Calls that pass a timeout must keep working."}
{"id": "stable_dedup", "seed": "stable_dedup/seed", "grade": "stable_dedup/grade_test.py", "prompt": "dedup in dedup.py uses set() and loses ordering. Fix it so duplicates are removed while preserving first-seen order."}
{"id": "normalize_none", "seed": "normalize_none/seed", "grade": "normalize_none/grade_test.py", "prompt": "normalize in textnorm.py crashes when given None. Make normalize(None) return an empty string. Other behavior stays the same."}
